<Window x:Class="MusicMic.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MusicMic settings" Width="360" Height="238" ResizeMode="NoResize" WindowStyle="None"
        WindowStartupLocation="CenterOwner" AllowsTransparency="False" Background="Transparent"
        Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        AutomationProperties.Name="MusicMic settings">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" CornerRadius="8" GlassFrameThickness="-1" ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border x:Name="BackdropHost" Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="8" BorderBrush="{DynamicResource OuterBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="46" /><RowDefinition Height="1" /><RowDefinition /></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="16,0,8,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Settings" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="&#xE8BB;" Style="{StaticResource FluentIconButtonStyle}" Click="CloseSettings"
                        WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Close settings" />
            </Grid>
            <Border Grid.Row="1" Background="{DynamicResource DividerBrush}" />
            <StackPanel Grid.Row="2" Margin="18,16">
                <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,0,0,5" />
                <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" Style="{StaticResource FluentComboBoxStyle}"
                          Background="{DynamicResource ControlFillBrush}" AutomationProperties.Name="Theme preference" />
                <CheckBox Content="Start MusicMic with Windows" IsChecked="{Binding StartWithWindows}" Margin="0,20,0,0"
                          Foreground="{DynamicResource PrimaryTextBrush}" AutomationProperties.Name="Start MusicMic with Windows" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
