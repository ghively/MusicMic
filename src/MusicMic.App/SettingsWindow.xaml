<Window x:Class="MusicMic.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MusicMic settings" Width="360" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="None"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" AllowsTransparency="False" Background="Transparent"
        Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        AutomationProperties.Name="MusicMic settings">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" CornerRadius="0" GlassFrameThickness="-1" ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="BackdropHost" Background="{DynamicResource BackdropFallbackBrush}" CornerRadius="8"
            BorderBrush="{DynamicResource OuterBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="14,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Settings" Style="{StaticResource BodyStrongTextStyle}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="&#xE8BB;" Style="{StaticResource FluentIconButtonStyle}" Click="CloseSettings"
                        WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Close settings" ToolTip="Close" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="12,0,12,12">
                <Border Style="{StaticResource FluentCardStyle}" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE790;" Style="{StaticResource IconTextStyle}" HorizontalAlignment="Left"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Grid.Column="1" Text="App theme" VerticalAlignment="Center"
                                   Style="{StaticResource BodyTextStyle}" />
                        <ComboBox Grid.Column="2" Width="136" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}"
                                  Style="{StaticResource FluentComboBoxStyle}" AutomationProperties.Name="Theme preference" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource FluentCardStyle}" Padding="12,10" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7E8;" Style="{StaticResource IconTextStyle}" HorizontalAlignment="Left"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <CheckBox Grid.Column="1" Content="Start MusicMic when I sign in" IsChecked="{Binding StartWithWindows}"
                                  Style="{StaticResource FluentToggleSwitchStyle}"
                                  AutomationProperties.Name="Start MusicMic when I sign in" />
                    </Grid>
                </Border>

                <Grid Margin="2,12,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE946;" Style="{StaticResource IconTextStyle}" FontSize="14" HorizontalAlignment="Left"
                               VerticalAlignment="Top" Margin="0,1,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" TextTrimming="None"
                               LineHeight="16"
                               Text="MusicMic keeps running in the notification area. Select its icon to open the flyout, or right-click it to exit." />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
