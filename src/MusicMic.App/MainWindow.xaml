<Window x:Class="MusicMic.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:MusicMic.Core;assembly=MusicMic.Core"
        Title="MusicMic" Width="468" Height="604" MinWidth="440" MinHeight="570"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        AutomationProperties.Name="MusicMic audio injection utility">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /></Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38" /><Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="{DynamicResource ControlSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>
        <Style TargetType="Slider"><Setter Property="Height" Value="26" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Width" Value="36" /><Setter Property="Height" Value="32" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" /><Setter Property="FontSize" Value="16" /><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="42" /><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" /><Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInjecting}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlSurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20,17,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal"><Ellipse Width="9" Height="9" Fill="{DynamicResource AccentBrush}" Margin="1,0,9,0" VerticalAlignment="Center" /><TextBlock Text="MusicMic" FontSize="18" FontWeight="SemiBold" /></StackPanel>
                <TextBlock Text="Virtual microphone" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="19,3,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="⚙" Click="OpenSettings" Style="{StaticResource HeaderButton}" AutomationProperties.Name="Open MusicMic settings" ToolTip="Settings" />
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource MicaSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15,13" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="♫" FontSize="17" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Source" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding SourcePercentageLabel}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                </Grid>
                <ComboBox Grid.Row="1" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanChangeSelection}" Margin="28,10,0,5" AutomationProperties.Name="Audio source" />
                <Slider Grid.Row="2" Minimum="0" Maximum="100" Value="{Binding SourcePercentage}" IsEnabled="{Binding CanAdjustGains}" Margin="28,2,0,0" AutomationProperties.Name="Source volume percentage" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource MicaSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15,13" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="●" FontSize="15" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Microphone" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding MicrophonePercentageLabel}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                </Grid>
                <ComboBox Grid.Row="1" ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanChangeSelection}" Margin="28,10,0,5" AutomationProperties.Name="Physical microphone" />
                <Slider Grid.Row="2" Minimum="0" Maximum="100" Value="{Binding MicrophonePercentage}" IsEnabled="{Binding CanAdjustGains}" Margin="28,2,0,0" AutomationProperties.Name="Microphone volume percentage" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{DynamicResource AccentSubtleBrush}" CornerRadius="7" Padding="12,10" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Margin="0,0,9,0" VerticalAlignment="Center"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource AccentBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsInjecting}" Value="True"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}" /></DataTrigger><DataTrigger Binding="{Binding State}" Value="{x:Static core:InjectionState.OutputUnavailable}"><Setter Property="Fill" Value="{DynamicResource ErrorBrush}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
                <StackPanel><TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" /><TextBlock Text="{Binding StatusDetail}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" /></StackPanel>
            </StackPanel>
        </Border>

        <Button Grid.Row="4" Content="{Binding PrimaryActionText}" Command="{Binding ToggleInjectionCommand}" IsEnabled="{Binding CanToggleInjection}" Style="{StaticResource ActionButton}" AutomationProperties.Name="Start or stop MusicMic injection" />

        <Border Grid.Row="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="1,13,1,0" Margin="0,12,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="♪" Foreground="{DynamicResource AccentBrush}" FontSize="15" /><TextBlock Grid.Column="1" Text="{Binding PlaybackAssuranceText}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" LineHeight="18" AutomationProperties.Name="Normal playback assurance" /></Grid>
        </Border>
    </Grid>
</Window>
