<Window x:Class="MusicMic.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:MusicMic.Core;assembly=MusicMic.Core"
        Title="MusicMic" Width="500" Height="640" MinWidth="500" MinHeight="600"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,22">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="MusicMic" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Share one app and your microphone" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Settings" Padding="12,7" Click="OpenSettings" />
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,8"><TextBlock Text="Application audio" FontWeight="SemiBold"/><TextBlock Text="{Binding SourcePercentageLabel}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedTextBrush}"/></Grid>
                <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" DisplayMemberPath="DisplayName" />
                <Slider Minimum="0" Maximum="100" Value="{Binding SourcePercentage}" Margin="0,14,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,8"><TextBlock Text="Microphone" FontWeight="SemiBold"/><TextBlock Text="{Binding MicrophonePercentageLabel}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedTextBrush}"/></Grid>
                <ComboBox ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}" DisplayMemberPath="DisplayName" />
                <Slider Minimum="0" Maximum="100" Value="{Binding MicrophonePercentage}" Margin="0,14,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="{DynamicResource AssuranceBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,5,0,0" />
                <TextBlock Grid.Column="1" Text="{Binding PlaybackAssuranceText}" TextWrapping="Wrap" LineHeight="20" />
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StatusDetail}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" MaxWidth="290" Margin="0,3,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="{Binding PrimaryActionText}" Command="{Binding ToggleInjectionCommand}"
                    IsEnabled="{Binding CanToggleInjection}" MinWidth="112" Height="44" FontWeight="SemiBold"
                    Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" />
        </Grid>
    </Grid>
</Window>
