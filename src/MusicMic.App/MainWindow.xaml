<Window x:Class="MusicMic.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:MusicMic.Core;assembly=MusicMic.Core"
        Title="MusicMic" Width="500" Height="680" MinWidth="500" MinHeight="650"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        AutomationProperties.Name="MusicMic audio injection utility">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="46" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StopButton" TargetType="Button">
            <Setter Property="Height" Value="46" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="28,22,28,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="12" Height="12" Fill="{DynamicResource AccentBrush}" Margin="0,0,9,0" />
                <TextBlock Text="MusicMic" FontSize="20" FontWeight="SemiBold" />
            </StackPanel>
            <Button Grid.Column="1" Content="Settings" Padding="12,7" Click="OpenSettings"
                    AutomationProperties.Name="Open MusicMic settings" />
        </Grid>

        <!-- Approved compact idle workflow. -->
        <Grid Grid.Row="1" Margin="28,0,28,18">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsInjecting}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="AUDIO SOURCE" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,8" />
            <ComboBox Grid.Row="1" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"
                      DisplayMemberPath="DisplayName" IsEnabled="{Binding CanChangeSelection}"
                      AutomationProperties.Name="Audio source" />
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <TextBlock Text="Source volume" FontSize="13" />
                <TextBlock Text="{Binding SourcePercentageLabel}" HorizontalAlignment="Right"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </Grid>
            <Slider Grid.Row="3" Minimum="0" Maximum="100" Value="{Binding SourcePercentage}"
                    Margin="0,5,0,8" AutomationProperties.Name="Source volume percentage" />

            <TextBlock Grid.Row="4" Text="↓" FontSize="20" HorizontalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"
                       AutomationProperties.Name="Source audio combines with microphone" />

            <StackPanel Grid.Row="5">
                <TextBlock Text="MICROPHONE" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,8" />
                <ComboBox ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}"
                          DisplayMemberPath="DisplayName" IsEnabled="{Binding CanChangeSelection}"
                          AutomationProperties.Name="Physical microphone" />
                <Grid Margin="0,12,0,0">
                    <TextBlock Text="Mic volume" FontSize="13" />
                    <TextBlock Text="{Binding MicrophonePercentageLabel}" HorizontalAlignment="Right"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </Grid>
                <Slider Minimum="0" Maximum="100" Value="{Binding MicrophonePercentage}"
                        Margin="0,5,0,0" AutomationProperties.Name="Microphone volume percentage" />
            </StackPanel>

            <StackPanel Grid.Row="6" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Ellipse Width="8" Height="8" Margin="0,0,9,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static core:InjectionState.SourceUnavailable}">
                                        <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding SourceStatusText}" FontSize="13" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Margin="0,0,9,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static core:InjectionState.MicrophoneUnavailable}">
                                        <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding MicrophoneStatusText}" FontSize="13" />
                </StackPanel>
                <TextBlock Text="{Binding StatusDetail}" Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap" FontSize="12" Margin="17,8,0,0"
                           AutomationProperties.Name="{Binding StatusText}" />
            </StackPanel>

            <Button Grid.Row="8" Content="{Binding PrimaryActionText}" Command="{Binding ToggleInjectionCommand}"
                    IsEnabled="{Binding CanToggleInjection}" Style="{StaticResource PrimaryButton}"
                    AutomationProperties.Name="Start injecting selected source and microphone" />
        </Grid>

        <!-- Approved simplified active state: source and mic converge on one virtual mic. -->
        <Grid Grid.Row="1" Margin="28,6,28,22">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsInjecting}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource SecondarySurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="24" Margin="0,0,0,22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="100" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel HorizontalAlignment="Center" MaxWidth="170">
                            <TextBlock Text="{Binding ActiveSourceName}" FontSize="16" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                            <Ellipse Width="12" Height="12" Fill="{DynamicResource SuccessBrush}" Margin="0,10,0,0" />
                            <TextBlock Text="App copy" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" MaxWidth="170">
                            <TextBlock Text="{Binding ActiveMicrophoneName}" FontSize="16" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                            <TextBlock Text="●" FontSize="17" Foreground="{DynamicResource SuccessBrush}"
                                       HorizontalAlignment="Center" Margin="0,5,0,0"
                                       AutomationProperties.Name="Microphone input" />
                            <TextBlock Text="Microphone" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                       HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <Canvas Grid.Row="1" Width="320" Height="100" HorizontalAlignment="Center"
                            IsHitTestVisible="False" AutomationProperties.Name="Both inputs combine in MusicMic">
                        <Path Data="M 68,10 L 160,82 L 252,10" Stroke="{DynamicResource AccentBrush}"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Ellipse Canvas.Left="154" Canvas.Top="76" Width="12" Height="12"
                                 Fill="{DynamicResource AccentBrush}" />
                    </Canvas>

                    <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                        <TextBlock Text="MusicMic" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Virtual Mic" Foreground="{DynamicResource MutedTextBrush}"
                                   HorizontalAlignment="Center" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
                        <Ellipse Width="9" Height="9" Fill="{DynamicResource SuccessBrush}" Margin="0,0,9,0" />
                        <TextBlock Text="INJECTING" FontSize="13" FontWeight="SemiBold"
                                   AutomationProperties.Name="Injection status: injecting" />
                    </StackPanel>
                </Grid>
            </Border>

            <Button Grid.Row="1" Content="STOP" Command="{Binding ToggleInjectionCommand}"
                    Style="{StaticResource StopButton}" AutomationProperties.Name="Stop injecting" />
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource AssuranceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,1,0"
                Padding="28,15" AutomationProperties.Name="Normal playback assurance">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="♫" FontSize="16" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding PlaybackAssuranceText}" TextWrapping="Wrap" LineHeight="20" />
            </Grid>
        </Border>
    </Grid>
</Window>
