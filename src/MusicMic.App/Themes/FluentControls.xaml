<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:services="clr-namespace:MusicMic.App.Services">
    <services:SelectionDisplayNameConverter x:Key="SelectionDisplayNameConverter" />
    <services:BooleanVisibilityConverter x:Key="TrueToVisibleConverter" />
    <services:BooleanVisibilityConverter x:Key="FalseToVisibleConverter" Invert="True" />

    <!-- ===================== Type ramp (Windows 11) ===================== -->
    <sys:String x:Key="BodyFontFamily">Segoe UI Variable Text, Segoe UI</sys:String>
    <sys:String x:Key="DisplayFontFamily">Segoe UI Variable Display, Segoe UI</sys:String>
    <sys:String x:Key="IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</sys:String>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="BodyStrongTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="CaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TertiaryTextBrush}" />
    </Style>

    <Style x:Key="IconTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <!-- ===================== Card surface ===================== -->
    <Style x:Key="FluentCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardFillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ===================== Subtle icon button (flyout header) ===================== -->
    <Style x:Key="FluentIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="4"
                            BorderBrush="Transparent" BorderThickness="2" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillPressedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Accent button ===================== -->
    <Style x:Key="FluentActionButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentElevationBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="FocusRing" CornerRadius="6" Margin="-3" BorderThickness="2"
                                BorderBrush="Transparent" SnapsToDevicePixels="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                            <Setter TargetName="Surface" Property="BorderThickness" Value="0" />
                            <Setter Property="Opacity" Value="0.92" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentDisabledBrush}" />
                            <Setter TargetName="Surface" Property="BorderThickness" Value="0" />
                            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Standard button ===================== -->
    <Style x:Key="FluentStandardButtonStyle" TargetType="Button" BasedOn="{StaticResource FluentActionButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="FocusRing" CornerRadius="6" Margin="-3" BorderThickness="2"
                                BorderBrush="Transparent" SnapsToDevicePixels="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlFillHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlFillPressedBrush}" />
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlFillDisabledBrush}" />
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== ComboBox ===================== -->
    <Style x:Key="FluentComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="11,0,11,0" />
        <Setter Property="Margin" Value="4,2,4,2" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid>
                        <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <Rectangle x:Name="SelectionIndicator" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0"
                                   Fill="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource SubtleFillHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource SubtleFillHoverBrush}" />
                            <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FluentComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="11,0,34,0" />
        <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource FluentComboBoxItemStyle}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="ControlSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" SnapsToDevicePixels="True" />
                        <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <TextBlock x:Name="SelectionText" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                   IsHitTestVisible="False" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                   Text="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource SelectionDisplayNameConverter}}"
                                   Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="Chevron" Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                   Margin="0,0,11,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <Border x:Name="FocusRing" CornerRadius="6" Margin="-3" BorderThickness="2"
                                BorderBrush="Transparent" SnapsToDevicePixels="True" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4" HorizontalOffset="-12"
                               AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade" IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="264"
                                    Background="{DynamicResource PopupFillBrush}" BorderBrush="{DynamicResource PopupStrokeBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="0,4" Margin="12,0,12,12">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.22" Color="#000000" />
                                </Border.Effect>
                                <ScrollViewer CanContentScroll="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ControlSurface" Property="Background" Value="{DynamicResource ControlFillHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="ControlSurface" Property="Background" Value="{DynamicResource ControlFillPressedBrush}" />
                            <Setter TargetName="ControlSurface" Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}" />
                            <Setter TargetName="SelectionText" Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ControlSurface" Property="Background" Value="{DynamicResource ControlFillDisabledBrush}" />
                            <Setter TargetName="ControlSurface" Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}" />
                            <Setter TargetName="SelectionText" Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                            <Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Slider ===================== -->
    <Style x:Key="FluentSliderStyle" TargetType="Slider">
        <Setter Property="Height" Value="22" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="SmallChange" Value="1" />
        <Setter Property="LargeChange" Value="10" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True">
                        <Border x:Name="FocusRing" CornerRadius="6" Margin="-4,-2,-4,-2" BorderThickness="2"
                                BorderBrush="Transparent" SnapsToDevicePixels="True" />
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border x:Name="FilledTrack" Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" Background="{DynamicResource SliderTrackBrush}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" Width="20" Height="20" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent">
                                                <Ellipse x:Name="Shell" Width="20" Height="20"
                                                         Fill="{DynamicResource ControlSolidFillBrush}"
                                                         Stroke="{DynamicResource SliderThumbBorderBrush}" StrokeThickness="1" />
                                                <Ellipse x:Name="Knob" Width="12" Height="12" Fill="{DynamicResource AccentBrush}" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Knob" Property="Width" Value="14" />
                                                    <Setter TargetName="Knob" Property="Height" Value="14" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Knob" Property="Width" Value="10" />
                                                    <Setter TargetName="Knob" Property="Height" Value="10" />
                                                    <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource AccentPressedBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Toggle switch ===================== -->
    <Style x:Key="FluentToggleSwitchStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}" />
                        <Grid Grid.Column="1" Width="40" Height="20" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Border x:Name="SwitchTrack" CornerRadius="10" Background="{DynamicResource ControlFillPressedBrush}"
                                    BorderBrush="{DynamicResource ControlStrongStrokeBrush}" BorderThickness="1" />
                            <Ellipse x:Name="SwitchKnob" Width="12" Height="12" HorizontalAlignment="Left" Margin="4,0,0,0"
                                     Fill="{DynamicResource ControlStrongStrokeBrush}" />
                            <Border x:Name="FocusRing" CornerRadius="12" Margin="-3" BorderThickness="2"
                                    BorderBrush="Transparent" SnapsToDevicePixels="True" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource AccentElevationBorderBrush}" />
                            <Setter TargetName="SwitchKnob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="SwitchKnob" Property="Margin" Value="0,0,4,0" />
                            <Setter TargetName="SwitchKnob" Property="Fill" Value="{DynamicResource AccentForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SwitchKnob" Property="Width" Value="14" />
                            <Setter TargetName="SwitchKnob" Property="Height" Value="14" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource ControlFillHoverBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
