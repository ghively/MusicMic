<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Windows 11 (WinUI 3) dark theme resources. Names mirror the platform tokens so the
         flyout reads as shell surface rather than an app-specific palette. -->
    <sys:Boolean x:Key="IsDarkTheme">True</sys:Boolean>
    <Color x:Key="FocusColor">#60CDFF</Color>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="BackdropFallbackBrush" Color="#202020" />
    <SolidColorBrush x:Key="LayerFillBrush" Color="#4C3A3A3A" />
    <SolidColorBrush x:Key="CardFillBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="CardStrokeBrush" Color="#19000000" />
    <SolidColorBrush x:Key="PopupFillBrush" Color="#2C2C2C" />
    <SolidColorBrush x:Key="PopupStrokeBrush" Color="#33000000" />
    <SolidColorBrush x:Key="ControlSolidFillBrush" Color="#454545" />

    <!-- Control fills -->
    <SolidColorBrush x:Key="ControlFillBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ControlFillHoverBrush" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="ControlFillPressedBrush" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="ControlFillDisabledBrush" Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="SubtleFillHoverBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="SubtleFillPressedBrush" Color="#0AFFFFFF" />

    <!-- Strokes -->
    <SolidColorBrush x:Key="ControlStrokeBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="ControlStrongStrokeBrush" Color="#9AFFFFFF" />
    <SolidColorBrush x:Key="DividerBrush" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="OuterBorderBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="FocusStrokeBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="#8BFFFFFF" />
    <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="#18FFFFFF" />
    <!-- Control elevation border: a hairline that is lighter along the top edge. -->
    <LinearGradientBrush x:Key="ControlElevationBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#18FFFFFF" />
        <GradientStop Offset="0.1" Color="#12FFFFFF" />
        <GradientStop Offset="1.0" Color="#12FFFFFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentElevationBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#14FFFFFF" />
        <GradientStop Offset="0.9" Color="#14FFFFFF" />
        <GradientStop Offset="1.0" Color="#23000000" />
    </LinearGradientBrush>

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#C5FFFFFF" />
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#87FFFFFF" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#5DFFFFFF" />

    <!-- Accent (replaced at runtime with the user's Windows accent colour) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#E660CDFF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#CC60CDFF" />
    <SolidColorBrush x:Key="AccentDisabledBrush" Color="#28FFFFFF" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#2660CDFF" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#99EBFF" />

    <!-- System states -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF99A4" />
    <SolidColorBrush x:Key="CautionBrush" Color="#FCE100" />
</ResourceDictionary>
