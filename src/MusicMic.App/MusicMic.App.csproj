<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>MusicMic</AssemblyName>
    <RootNamespace>MusicMic.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MusicMic.Core\MusicMic.Core.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <NativeAudioLibraryPath>$(MSBuildProjectDirectory)\..\MusicMic.Audio\out-build\$(Configuration)\MusicMic.Audio.dll</NativeAudioLibraryPath>
  </PropertyGroup>
  <Target Name="CopyNativeAudioLibrary" AfterTargets="Build;Publish" Condition="Exists('$(NativeAudioLibraryPath)')">
    <Copy SourceFiles="$(NativeAudioLibraryPath)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
