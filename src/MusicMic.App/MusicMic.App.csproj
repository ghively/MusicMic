<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>MusicMic</AssemblyName>
    <RootNamespace>MusicMic.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MusicMic.Core\MusicMic.Core.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <NativeAudioLibraryPath>$(MSBuildProjectDirectory)\..\MusicMic.Audio\out-build\$(Configuration)\MusicMic.Audio.dll</NativeAudioLibraryPath>
  </PropertyGroup>
  <Target Name="ValidateNativeAudioLibrary" BeforeTargets="CopyNativeAudioLibraryToBuildOutput;CopyNativeAudioLibraryToPublish" Condition="!Exists('$(NativeAudioLibraryPath)')">
    <Error Text="MusicMic.Audio.dll is required but was not found at $(NativeAudioLibraryPath). Build src\\MusicMic.Audio for x64 $(Configuration) first." />
  </Target>
  <Target Name="CopyNativeAudioLibraryToBuildOutput" AfterTargets="Build" DependsOnTargets="ValidateNativeAudioLibrary">
    <Copy SourceFiles="$(NativeAudioLibraryPath)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyNativeAudioLibraryToPublish" AfterTargets="Publish" DependsOnTargets="ValidateNativeAudioLibrary">
    <Copy SourceFiles="$(NativeAudioLibraryPath)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
